	attempts = int(parsed.get("attempts", 0))
	misses = int(parsed.get("misses", 0))
	best_streak = int(parsed.get("best_streak", 0))
	intervals.clear()
	for value in parsed.get("intervals", []): intervals.append(float(value))
	reaction_times.clear()
	for value in parsed.get("reaction_times", []): reaction_times.append(float(value))
	var loaded_stats = parsed.get("behavior_stats", {})
	if typeof(loaded_stats) == TYPE_DICTIONARY:
		for name in behaviors:
			if loaded_stats.has(name) and typeof(loaded_stats[name]) == TYPE_DICTIONARY:
				behavior_stats[name] = loaded_stats[name]
	var loaded_rare = parsed.get("seen_rare", {})
	if typeof(loaded_rare) == TYPE_DICTIONARY:
		seen_rare = loaded_rare
	returning_player = successes > 0
	_update_profile()

func _forget_everything() -> void:
	if FileAccess.file_exists(SAVE_PATH):
		DirAccess.remove_absolute(ProjectSettings.globalize_path(SAVE_PATH))
	successes = 0
	attempts = 0
	misses = 0
	streak = 0
	best_streak = 0
	intervals.clear()
	reaction_times.clear()
	recent_behaviors.clear()
	recent_lines.clear()
	seen_rare.clear()
	_init_stats()
	current_profile = "UNKNOWN"
	last_attempt_ms = 0
	last_success_ms = 0
	_cleanup_challenge()
	_update_hud()
	_say("Who are you?")
	_compose_next(false)

func _pick(values: Array) -> String:
	return str(values[rng.randi_range(0, values.size() - 1)])
